{
  "$schema": "https://opencode.ai/config.json",

  "mcp": {
    "dart-mcp-server": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server"
      ],
      "enabled": true,
      "environment": {}
    }
  },

  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router",

      "options": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },

      "models": {
        "maut": {
          "name": "9Router MAUT Combo"
        }
      }
    }
  }
}